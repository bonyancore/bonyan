# Copy to audit/config.env and fill in. Never commit real secrets (use throw-away dev tokens).
# --- API ---
AUDIT_BASE_URL=http://127.0.0.1:8080
AUDIT_OPENAPI=/openapi/v1.json            # URL path on the API, or a local file path
AUDIT_PATH_PREFIX=/api/v1/
AUDIT_PUBLIC_REGEX=^/(health|healthz|ready|live)
AUDIT_TOKEN_ADMIN_A=                      # tenant A, ALL permissions
AUDIT_TOKEN_NOPERM_A=                     # tenant A, authenticated, NO permissions
AUDIT_TOKEN_ADMIN_B=                      # tenant B, all permissions (needed for tenant isolation scenarios)
AUDIT_SCENARIOS=api/scenarios.yaml
# --- Database (use a DEV/TEST database only) ---
AUDIT_DB_DSN=postgresql://owner_or_readonly@localhost:5432/constructionconnect_dev   # can read the catalog and tables
AUDIT_DB_DSN_APP=postgresql://app_role@localhost:5432/constructionconnect_dev        # the runtime role (optional but recommended)
AUDIT_DB_APP_ROLE=app_role
AUDIT_DB_SCHEMAS=platform,cost,cash
AUDIT_TENANT_SETTING=app.tenant_id
# --- Behaviour ---
AUDIT_STRICT=0     # 1 = anything unverified (missing scenario, table not built, empty table) FAILS instead of skipping
