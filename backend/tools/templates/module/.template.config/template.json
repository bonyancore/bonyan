{
  "$schema": "http://json.schemastore.org/template",
  "author": "Bonyan Team",
  "classifications": [ "Bonyan", "Module" ],
  "name": "Bonyan Module Template",
  "description": "Creates a five-project module for Bonyan Construction ERP conforming to Spec 20 and ADR-001.",
  "identity": "Construction.Module.Template",
  "shortName": "cc-module",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "TemplateModule",
  "preferNameDirectory": true,
  "symbols": {
    "moduleCode": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "name",
        "toLower": true
      },
      "replaces": "templatemodule"
    }
  }
}
